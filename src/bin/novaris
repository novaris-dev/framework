#!/usr/bin/env php
<?php
/**
 * Novaris command-line interface.
 *
 * Provides the command-line entry point for Novaris.
 *
 * @package   Novaris
 * @author    Benjamin Lu <benlumia007@gmail.com>
 * @copyright 2024 Benjamin Lu
 * @license   https://www.gnu.org/licenses/gpl-2.0.html
 * @link      https://github.com/novaris-dev/framework
 */

declare(strict_types=1);

if ( PHP_SAPI !== 'cli' ) {
	exit( 1 );
}

define( 'NOVARIS_CLI', true );

// Find Composer's autoloader. Composer's `vendor/bin/novaris` proxy passes
// its path. Otherwise, check the usual install location relative to this
// file, then the current folder. Relative paths alone are not enough: when
// the framework is symlinked into `vendor/` (a Composer path repository),
// PHP resolves `__DIR__` to the real folder outside the site.
$autoload = $GLOBALS['_composer_autoload_path'] ?? null;

if ( ! $autoload ) {
	foreach ( [
		dirname( __DIR__, 4 ) . '/autoload.php',
		getcwd() . '/vendor/autoload.php',
	] as $candidate ) {
		if ( is_file( $candidate ) ) {
			$autoload = $candidate;
			break;
		}
	}
}

if ( ! $autoload || ! is_file( $autoload ) ) {
	fwrite( STDERR, 'Novaris: unable to find vendor/autoload.php. Run `composer install` in your site folder, then run this command from there.' . PHP_EOL );
	exit( 1 );
}

require $autoload;

// The site root is the folder that contains the `vendor` folder.
$root = dirname( realpath( $autoload ), 2 );

use Novaris\Contracts\Content\{
	ContentQuery,
	ContentTypes
};
use Novaris\Contracts\Routing\RoutingRouter;
use Novaris\Core\Application;
use Novaris\Export\Exporter;

$version = Application::VERSION;
$command = $argv[1] ?? '';

switch ( $command ) {
	case 'cache:clear':
		$path = $root;

		$app = new Application( $path );
		$app->boot();

		\Novaris\Cache::purge();

		echo 'Cache cleared successfully.' . PHP_EOL;
		break;

	case 'theme:update':
		$path = $root;

		$app = new Application( $path );
		$app->boot();

		$installer = $app->make( 'theme.installer' );
		$metadata  = $app->make( 'theme.metadata' );

		$parentPath = parent_theme_path();
		$themePath  = $parentPath ?: theme_path();

		$current = $metadata->read( $themePath );

		$theme = $current['name']
			?? $current['slug']
			?? basename( $themePath );

		$currentVersion = $current['version'] ?? '';

		if ( ! $installer->updateAvailable( $themePath ) ) {
			echo "\033[32mSuccess:\033[0m {$theme} is already up to date ({$currentVersion})." . PHP_EOL;
			break;
		}

		$installer->updateActive();

		$updated = $metadata->read( $themePath );

		$newVersion = $updated['version'] ?? '';

		echo "\033[32mSuccess:\033[0m {$theme} updated from {$currentVersion} to {$newVersion}." . PHP_EOL;
		break;

	case 'export':
		$path  = $root;
		$url   = null;
		$watch = false;
		$count = false;

		foreach ( array_slice( $argv, 2 ) as $argument ) {
			if ( str_starts_with( $argument, '--url=' ) ) {
				$url = substr( $argument, 6 );
				$url = rtrim( $url, '/' );
			}

			if ( '--watch' === $argument ) {
				$watch = true;
			}

			if ( '--count' === $argument ) {
				$count = true;
			}
		}

		$app = new Application( $path );
		$app->boot();

		$exportPath = $app->publicPath();

		if ( ! $watch ) {
			$exporter = new Exporter(
				$app->make( RoutingRouter::class ),
				$app->make( ContentTypes::class ),
				$app->make( ContentQuery::class ),
				$exportPath,
				$url
			);

			$exported = $exporter->export();
			$total    = count( $exported );

			if ( $count ) {
				echo $total . PHP_EOL;
			}

			break;
		}

		$watchPaths = [
			$app->contentPath(),
			$app->viewPath(),
			theme_path( 'app' ),
			theme_path( 'config' ),
			theme_path( 'resources' ),
		];

		$scan = static function ( array $paths ): array {
			$files = [];

			foreach ( $paths as $watchPath ) {
				if ( ! is_dir( $watchPath ) ) {
					continue;
				}

				$iterator = new RecursiveIteratorIterator(
					new RecursiveDirectoryIterator(
						$watchPath,
						RecursiveDirectoryIterator::SKIP_DOTS
					)
				);

				foreach ( $iterator as $file ) {
					if ( ! $file->isFile() ) {
						continue;
					}

					$files[ $file->getPathname() ] = $file->getMTime();
				}
			}

			ksort( $files );

			return $files;
		};

		$runExport = static function () use ( $argv, $url ): int {
			$command = escapeshellarg( PHP_BINARY )
				. ' '
				. escapeshellarg( $argv[0] )
				. ' export --count';

			if ( $url ) {
				$command .= ' --url=' . escapeshellarg( $url );
			}

			$command .= ' 2>&1';

			$output = [];
			$status = 0;

			exec( $command, $output, $status );

			if ( 0 !== $status ) {
				echo '✗ Export failed' . PHP_EOL;

				if ( $output ) {
					echo implode( PHP_EOL, $output ) . PHP_EOL;
				}

				return 0;
			}

			$last = $output
				? trim( $output[ count( $output ) - 1 ] )
				: null;

			if ( null === $last || ! is_numeric( $last ) ) {
				echo '✗ Export failed' . PHP_EOL;

				if ( $output ) {
					echo implode( PHP_EOL, $output ) . PHP_EOL;
				}

				return 0;
			}

			return (int) $last;
		};

		if ( function_exists( 'pcntl_async_signals' ) ) {
			pcntl_async_signals( true );

			$stop = static function (): void {
				echo PHP_EOL . '■ Watcher stopped.' . PHP_EOL;

				exit( 0 );
			};

			pcntl_signal( SIGINT, $stop );
			pcntl_signal( SIGTERM, $stop );
		}

		$pages = $runExport();

		if ( $pages ) {
			echo "✓ Generated {$pages} pages" . PHP_EOL;
		}

		echo '◉ Watching for changes...' . PHP_EOL;

		$modified = $scan( $watchPaths );

		while ( true ) {
			usleep( 250000 );

			$current = $scan( $watchPaths );

			if ( $current === $modified ) {
				continue;
			}

			$modified = $current;

			$runExport();

			$modified = $scan( $watchPaths );
		}

	case '--version':
	case '-V':
		echo "Novaris {$version}" . PHP_EOL;
		break;

	case '--help':
	case '-h':
		echo "Novaris {$version}" . PHP_EOL;
		echo PHP_EOL;
		echo 'Usage:' . PHP_EOL;
		echo '  novaris [command] [options]' . PHP_EOL;
		echo PHP_EOL;
		echo 'Commands:' . PHP_EOL;
		echo '  cache:clear    Clear all cache stores' . PHP_EOL;
		echo '  theme:update   Update the active theme' . PHP_EOL;
		echo '  export         Export the site as static HTML' . PHP_EOL;
		echo PHP_EOL;
		echo 'Options:' . PHP_EOL;
		echo '  --url=URL        Set the URL for the static export' . PHP_EOL;
		echo '  --watch          Watch for changes and re-export' . PHP_EOL;
		echo '  -h, --help       Display help' . PHP_EOL;
		echo '  -V, --version    Display the Novaris version' . PHP_EOL;
		break;

	default:
		echo "Novaris {$version}" . PHP_EOL;
		break;
}