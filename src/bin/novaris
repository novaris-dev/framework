declare(strict_types=1);

if ( PHP_SAPI !== 'cli' ) {
	exit( 1 );
}

define( 'NOVARIS_CLI', true );

require dirname( __DIR__, 2 ) . '/vendor/autoload.php';

$version = \Novaris\Core\Application::VERSION;

echo "Novaris {$version}" . PHP_EOL;