#!/usr/bin/env php
<?php
/**
 * Novaris command-line interface.
 *
 * Provides the command-line entry point for Novaris.
 *
 * @package   Novaris
 * @author    Benjamin Lu <benlumia007@gmail.com>
 * @copyright 2024 Benjamin Lu
 * @license   https://www.gnu.org/licenses/gpl-2.0.html
 * @link      https://github.com/novaris-dev/framework
 */

declare(strict_types=1);

if ( PHP_SAPI !== 'cli' ) {
	exit( 1 );
}

define( 'NOVARIS_CLI', true );

require dirname( __DIR__, 4 ) . '/autoload.php';

use Novaris\Contracts\Content\{
	ContentQuery,
	ContentTypes
};
use Novaris\Contracts\Routing\RoutingRouter;
use Novaris\Core\Application;
use Novaris\Export\Exporter;

$version = Application::VERSION;
$command = $argv[1] ?? '';

switch ( $command ) {
	case 'cache:clear':
		$path = dirname( __DIR__, 5 );

		$app = new Application( $path );
		$app->boot();

		\Novaris\Cache::purge();

		echo 'Cache cleared successfully.' . PHP_EOL;
		break;

	case 'theme:update':
		$path = dirname( __DIR__, 5 );

		$app = new Application( $path );
		$app->boot();

		$installer = $app->make( 'theme.installer' );
		$metadata  = $app->make( 'theme.metadata' );

		$parentPath = parent_theme_path();
		$themePath  = $parentPath ?: theme_path();

		$current = $metadata->read( $themePath );

		$theme = $current['name']
			?? $current['slug']
			?? basename( $themePath );

		$currentVersion = $current['version'] ?? '';

		if ( ! $installer->updateAvailable( $themePath ) ) {
			echo "\033[32mSuccess:\033[0m {$theme} is already up to date ({$currentVersion})." . PHP_EOL;
			break;
		}

		$installer->updateActive();

		$updated = $metadata->read( $themePath );

		$newVersion = $updated['version'] ?? '';

		echo "\033[32mSuccess:\033[0m {$theme} updated from {$currentVersion} to {$newVersion}." . PHP_EOL;
		break;

	case 'export':
		$path = dirname( __DIR__, 5 );
		$url  = null;

		foreach ( array_slice( $argv, 2 ) as $argument ) {
			if ( str_starts_with( $argument, '--url=' ) ) {
				$url = substr( $argument, 6 );
				$url = rtrim( $url, '/' );
			}
		}

		$app = new Application( $path );
		$app->boot();

		$exportPath = $path . '/dist';

		$exporter = new Exporter(
			$app->make( RoutingRouter::class ),
			$app->make( ContentTypes::class ),
			$app->make( ContentQuery::class ),
			$exportPath,
			$url
		);

		$exported = $exporter->export();

		echo sprintf(
			'Exported %d paths to %s',
			count( $exported ),
			$exportPath
		) . PHP_EOL;
		break;

	case '--version':
	case '-V':
		echo "Novaris {$version}" . PHP_EOL;
		break;

	case '--help':
	case '-h':
		echo "Novaris {$version}" . PHP_EOL;
		echo PHP_EOL;
		echo 'Usage:' . PHP_EOL;
		echo '  novaris [command] [options]' . PHP_EOL;
		echo PHP_EOL;
		echo 'Commands:' . PHP_EOL;
		echo '  cache:clear    Clear all cache stores' . PHP_EOL;
		echo '  theme:update   Update the active theme' . PHP_EOL;
		echo '  export         Export the site as static HTML' . PHP_EOL;
		echo PHP_EOL;
		echo 'Options:' . PHP_EOL;
		echo '  --url=URL        Set the URL for the static export' . PHP_EOL;
		echo '  -h, --help       Display help' . PHP_EOL;
		echo '  -V, --version    Display the Novaris version' . PHP_EOL;
		break;

	default:
		echo "Novaris {$version}" . PHP_EOL;
		break;
}